# ── Gemini API Key (Google AI Studio에서 발급) ──────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Ollama 서버 주소 (기본값: localhost) ────────────────────
# 기본값은 http://localhost:11434 이므로 로컬 실행 시 생략 가능
# OLLAMA_BASE_URL=http://localhost:11434

# ── Instagram 세션 (선택) ───────────────────────────────────
# Instagram URL 분석 시 필요. instaloader로 세션 생성 후 입력
# INSTAGRAM_USERNAME=your_instagram_id
