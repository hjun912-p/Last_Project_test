{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyM0jXbWHVxC8q7mEnUDUwfc"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"markdown","source":["#  Phase 1 — 환경 세팅"],"metadata":{"id":"oylCWKn951GC"}},{"cell_type":"code","source":["!pip -q install timm==1.0.11 transformers==4.45.2 \\\n","                accelerate==1.0.1 scikit-learn==1.5.2 \\\n","                google-generativeai==0.8.3 optuna==3.6.1 \\\n","                opencv-python-headless==4.10.0.84 \\\n","                rarfile==4.2\n","!apt-get install -y -qq unrar"],"metadata":{"id":"aAToGp-Q50z8"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import os, json, random, time, copy, re, shutil, zipfile, tarfile, gzip, rarfile\n","from pathlib import Path\n","from collections import defaultdict, Counter\n","import numpy as np, pandas as pd\n","import matplotlib.pyplot as plt\n","from PIL import Image\n","import cv2\n","\n","import torch, torch.nn as nn, torch.nn.functional as F\n","from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\n","from torch.amp import autocast, GradScaler\n","\n","from transformers import CLIPModel\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import (accuracy_score, precision_score, recall_score,\n","                             f1_score, confusion_matrix, ConfusionMatrixDisplay,\n","                             roc_auc_score, roc_curve)\n","\n","SEED = 42\n","random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\n","torch.cuda.manual_seed_all(SEED)\n","\n","device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print('Device:', device, '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU')"],"metadata":{"id":"sXIqwCtQ50xp"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')"],"metadata":{"id":"KBDqnSw750vl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 경로 + 하이퍼 파라미터\n","# ✅ 본인 환경에 맞게 수정\n","DRIVE_ROOT = Path('/content/drive/MyDrive/github')\n","GENVID_DIR = DRIVE_ROOT / 'GenVidBench'\n","\n","# 로컬 (세션 한정)\n","REAL_LOCAL       = Path('/content/real_videos');  REAL_LOCAL.mkdir(exist_ok=True, parents=True)\n","FAKE_EXTRA_LOCAL = Path('/content/fake_extra');   FAKE_EXTRA_LOCAL.mkdir(exist_ok=True, parents=True)\n","WORK             = Path('/content/work');         WORK.mkdir(exist_ok=True)\n","OUT              = WORK / 'outputs';              OUT.mkdir(exist_ok=True)\n","\n","# 드라이브 (영구 보존)\n","FRAME_DIR = DRIVE_ROOT / 'frame_cache';   FRAME_DIR.mkdir(exist_ok=True, parents=True)\n","CKPT_DIR  = DRIVE_ROOT / 'checkpoints';   CKPT_DIR.mkdir(exist_ok=True, parents=True)\n","\n","# 드라이브의 fake 생성기 폴더 (압축 해제 안 된 상태로 영상이 직접 있는 경우)\n","FAKE_GENERATORS_DRIVE = ['cogvideo','mora','ms','pika','svd','t2vz','vc2']\n","\n","# 분류 키워드\n","AI_GEN_KEYWORDS = ['opensora','sora','gen2','gen3','runway','kling','luma',\n","                   'pika','cogvideo','mora','svd','videocrafter','modelscope',\n","                   'zeroscope','animatediff','hunyuan','t2vz','vc2','ms']\n","REAL_KEYWORDS = ['6.7m','webvid','msrvtt','kinetics','real','natural']\n","\n","# 하이퍼파라미터\n","IMG_SIZE              = 224\n","FRAMES_PER_VIDEO      = 6\n","BATCH                 = 16\n","NUM_WORKERS           = 2\n","EPOCHS                = 10\n","LR_HEAD               = 5e-4\n","LR_LORA               = 1e-4\n","WD                    = 1e-4\n","MAX_VIDEOS_PER_CLASS  = 20000   # real, fake 각 500개 (총 1000개)\n","VIDEO_EXT             = {'.mp4','.avi','.mov','.mkv','.webm'}\n","\n","print(f'GenVidBench 경로 존재: {GENVID_DIR.exists()}')"],"metadata":{"id":"4kga1xr750tQ"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 2 — 압축 해제 (zip + rar + tar.gz 통합)"],"metadata":{"id":"1WMfBR3u6Eay"}},{"cell_type":"code","source":["def find_archives(root):\n","    arcs = []\n","    for p in root.rglob('*'):\n","        if not p.is_file(): continue\n","        n = p.name.lower()\n","        if (n.endswith(('.zip','.rar','.tar.gz','.tgz','.tar'))\n","            and not n.endswith('.csv.gz')):\n","            arcs.append(p)\n","    return sorted(arcs)\n","\n","def classify_archive(ap: Path):\n","    name_lower = ap.name.lower()\n","    parent_lower = ap.parent.name.lower()\n","\n","    for kw in REAL_KEYWORDS:\n","        if kw in name_lower or kw in parent_lower:\n","            return 'real', None\n","\n","    for kw in AI_GEN_KEYWORDS:\n","        if kw in name_lower or kw in parent_lower:\n","            for src in [name_lower, parent_lower]:\n","                m = re.search(r'(opensora|sora|cogvideo|mora|pika|svd|t2vz|vc2|ms|videocrafter|gen[23]|runway|kling|luma|modelscope|zeroscope|animatediff|hunyuan)', src)\n","                if m: return 'fake', m.group(1)\n","            return 'fake', kw\n","\n","    return 'fake', parent_lower or 'unknown'\n","\n","archives = find_archives(GENVID_DIR)\n","print(f'📦 발견된 압축파일 {len(archives)}개\\n')\n","\n","preview = defaultdict(list)\n","for ap in archives:\n","    kind, gen = classify_archive(ap)\n","    preview[f'{kind}/{gen}'].append(ap.name)\n","\n","print('🔍 분류 미리보기:')\n","for key, files in sorted(preview.items()):\n","    print(f'  [{key}]  {len(files)}개')\n","    for fn in files[:2]: print(f'    - {fn}')\n","    if len(files) > 2: print(f'    ... 외 {len(files)-2}개')"],"metadata":{"id":"HszZBloJ50qk"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def extract_archive(ap, dest):\n","    n = ap.name.lower()\n","    dest.mkdir(exist_ok=True, parents=True)\n","    if n.endswith('.zip'):\n","        with zipfile.ZipFile(ap,'r') as z: z.extractall(dest)\n","    elif n.endswith('.rar'):\n","        with rarfile.RarFile(str(ap)) as r: r.extractall(str(dest))\n","    elif n.endswith(('.tar.gz','.tgz')):\n","        with tarfile.open(ap,'r:gz') as t: t.extractall(dest)\n","    elif n.endswith('.tar'):\n","        with tarfile.open(ap,'r:') as t: t.extractall(dest)\n","    elif n.endswith('.gz'):\n","        out = dest / ap.stem\n","        with gzip.open(ap,'rb') as fi, open(out,'wb') as fo:\n","            shutil.copyfileobj(fi, fo)\n","\n","n_real = sum(1 for v in REAL_LOCAL.rglob('*') if v.suffix.lower() in VIDEO_EXT)\n","n_fake = sum(1 for v in FAKE_EXTRA_LOCAL.rglob('*') if v.suffix.lower() in VIDEO_EXT)\n","\n","if n_real >= 100:\n","    print(f'✅ 이미 REAL {n_real:,}개 / FAKE {n_fake:,}개 풀려있음 → 스킵')\n","else:\n","    print('🔄 압축 해제 시작\\n')\n","    failed = []\n","    for i, ap in enumerate(archives, 1):\n","        kind, gen = classify_archive(ap)\n","        dest = REAL_LOCAL if kind=='real' else (FAKE_EXTRA_LOCAL/gen)\n","        size_gb = ap.stat().st_size / (1024**3)\n","        t0 = time.time()\n","        print(f'  [{i}/{len(archives)}] [{kind.upper()}/{gen}] {ap.name} ({size_gb:.2f}GB)')\n","        try:\n","            extract_archive(ap, dest)\n","            print(f'    ✅ {time.time()-t0:.0f}초')\n","        except Exception as e:\n","            print(f'    ❌ {type(e).__name__}: {str(e)[:80]}')\n","            failed.append((ap.name, str(e)[:80]))\n","    n_real = sum(1 for v in REAL_LOCAL.rglob('*') if v.suffix.lower() in VIDEO_EXT)\n","    n_fake = sum(1 for v in FAKE_EXTRA_LOCAL.rglob('*') if v.suffix.lower() in VIDEO_EXT)\n","    print(f'\\n🎬 REAL {n_real:,}개 | FAKE {n_fake:,}개')\n","\n","free_gb = shutil.disk_usage('/content').free / (1024**3)\n","print(f'💾 /content 여유 공간: {free_gb:.1f} GB')"],"metadata":{"id":"cztq1T3n50oM"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 3 — 영상 수집 + EDA"],"metadata":{"id":"JpCuc4yO6MRk"}},{"cell_type":"code","source":["real_all = [v for v in REAL_LOCAL.rglob('*') if v.suffix.lower() in VIDEO_EXT]\n","\n","fake_all, fake_stats = [], {}\n","for name in FAKE_GENERATORS_DRIVE:\n","    vids = [v for v in (DRIVE_ROOT/name).rglob('*') if v.suffix.lower() in VIDEO_EXT]\n","    fake_all += vids\n","    if vids: fake_stats[f'{name}(drive)'] = len(vids)\n","if FAKE_EXTRA_LOCAL.exists():\n","    for sub in FAKE_EXTRA_LOCAL.iterdir():\n","        if sub.is_dir():\n","            vids = [v for v in sub.rglob('*') if v.suffix.lower() in VIDEO_EXT]\n","            fake_all += vids\n","            if vids: fake_stats[f'{sub.name}(local)'] = len(vids)\n","\n","real_all = list(set(real_all)); fake_all = list(set(fake_all))\n","print(f'✅ REAL {len(real_all):,}개 | FAKE {len(fake_all):,}개\\n')\n","for n, c in sorted(fake_stats.items(), key=lambda x: -x[1]):\n","    print(f'  {n}: {c:,}개')"],"metadata":{"id":"Y5J5w-z350l6"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# EDA 용 메타데이터 수집\n","\n","def collect_video_meta(paths, label):\n","    rows = []\n","    for p in paths:\n","        try:\n","            cap = cv2.VideoCapture(str(p))\n","            if not cap.isOpened(): continue\n","            w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n","            h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n","            fps = cap.get(cv2.CAP_PROP_FPS)\n","            n = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","            dur = n/fps if fps>0 else 0\n","            cap.release()\n","            rows.append({'path':str(p),'label':label,'width':w,'height':h,\n","                         'fps':round(fps,1),'n_frames':n,'duration':round(dur,2),\n","                         'size_mb':p.stat().st_size/(1024*1024),'format':p.suffix.lower()})\n","        except: pass\n","    return rows\n","\n","# EDA용 샘플링\n","random.seed(SEED)\n","n_eda = 200\n","real_eda = random.sample(real_all, min(n_eda, len(real_all)))\n","fake_eda = random.sample(fake_all, min(n_eda, len(fake_all)))\n","\n","print('메타 수집 중...')\n","meta = pd.DataFrame(collect_video_meta(fake_eda,1) + collect_video_meta(real_eda,0))\n","print(f'\\n✅ {len(meta)}개 영상 메타 수집 완료')\n","print(meta.groupby('label').agg(\n","    n=('path','count'), mean_w=('width','mean'), mean_dur=('duration','mean'),\n","    mean_fps=('fps','mean'), mean_mb=('size_mb','mean')).round(2))"],"metadata":{"id":"3l-iRpa550jl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# EDA 시각화 + 데이터누수 체크\n","\n","fig, ax = plt.subplots(2, 4, figsize=(18, 8))\n","for lbl, name, color in [(0,'real','steelblue'),(1,'fake','coral')]:\n","    sub = meta[meta['label']==lbl]\n","    ax[0,0].hist(sub['width'],    alpha=0.6, label=name, color=color, bins=20)\n","    ax[0,1].hist(sub['duration'], alpha=0.6, label=name, color=color, bins=20)\n","    ax[0,2].hist(sub['fps'],      alpha=0.6, label=name, color=color, bins=20)\n","    ax[0,3].hist(sub['size_mb'],  alpha=0.6, label=name, color=color, bins=20)\n","ax[0,0].set_title('Width');    ax[0,0].legend()\n","ax[0,1].set_title('Duration'); ax[0,1].legend()\n","ax[0,2].set_title('FPS');      ax[0,2].legend()\n","ax[0,3].set_title('Size(MB)'); ax[0,3].legend()\n","\n","# 샘플 프레임\n","def mid_frame(p):\n","    cap = cv2.VideoCapture(str(p))\n","    n = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","    cap.set(cv2.CAP_PROP_POS_FRAMES, n//2)\n","    ok, f = cap.read(); cap.release()\n","    return cv2.cvtColor(f, cv2.COLOR_BGR2RGB) if ok else None\n","\n","for i,(p,lab) in enumerate([(real_eda[0],'REAL'),(real_eda[1],'REAL'),(fake_eda[0],'FAKE'),(fake_eda[1],'FAKE')]):\n","    fr = mid_frame(p)\n","    if fr is not None: ax[1,i].imshow(fr)\n","    ax[1,i].set_title(lab); ax[1,i].axis('off')\n","plt.tight_layout(); plt.savefig(OUT/'eda.png', dpi=120); plt.show()\n","\n","# 데이터 누수 체크\n","print('\\n⚠️ 클래스 간 메타 분리도 (2배 이상 차이면 위험):')\n","for col in ['width','duration','fps','size_mb']:\n","    rm = meta[meta['label']==0][col].median()\n","    fm = meta[meta['label']==1][col].median()\n","    ratio = max(rm,fm) / max(min(rm,fm), 0.01)\n","    flag = '🚨' if ratio>2 else '✅'\n","    print(f'  {flag} {col:10s}: real={rm:.1f}  fake={fm:.1f}  (배수 {ratio:.2f}x)')"],"metadata":{"id":"I-zK7ve250hW"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 4 — 전처리"],"metadata":{"id":"sHjZrDCS6gWA"}},{"cell_type":"code","source":["def detect_gen(ps):\n","    for g in FAKE_GENERATORS_DRIVE:\n","        if f'/{g}/' in ps: return g\n","    if '/fake_extra/' in ps:\n","        return ps.split('/fake_extra/')[1].split('/')[0]\n","    return 'unknown'\n","\n","def sample_balanced(fake_list, cap):\n","    by = defaultdict(list)\n","    for v in fake_list: by[detect_gen(str(v))].append(v)\n","    per = cap // len(by)\n","    out = []\n","    for g, vs in by.items():\n","        random.shuffle(vs); out += vs[:per]\n","        print(f'   {g}: {min(per,len(vs))}개')\n","    return out\n","\n","random.seed(SEED)\n","random.shuffle(real_all)\n","real_sampled = real_all[:MAX_VIDEOS_PER_CLASS]\n","print(f'[REAL] {len(real_sampled)}개\\n[FAKE] 생성기별 균등 샘플링:')\n","fake_sampled = sample_balanced(fake_all, MAX_VIDEOS_PER_CLASS)\n","\n","records = [{'path':str(p),'label':0,'vid':f'real_{p.stem[:40]}'} for p in real_sampled]\n","records += [{'path':str(p),'label':1,'vid':f'fake_{detect_gen(str(p))}_{p.stem[:30]}'} for p in fake_sampled]\n","df = pd.DataFrame(records)\n","print(f'\\n총 {len(df)}개 | 분포: {df[\"label\"].value_counts().to_dict()}')"],"metadata":{"id":"D8cuRcge50ex"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# TRAN/VAL/TEST SPLIT\n","\n","train_df, tmp_df = train_test_split(df, test_size=0.30, stratify=df['label'], random_state=SEED)\n","val_df, test_df  = train_test_split(tmp_df, test_size=0.50, stratify=tmp_df['label'], random_state=SEED)\n","print(f'Train {len(train_df)} | Val {len(val_df)} | Test {len(test_df)}')"],"metadata":{"id":"jDyDUenB50ce"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 프레임추출\n","\n","def extract_frames(video_path, n=FRAMES_PER_VIDEO):\n","    cap = cv2.VideoCapture(str(video_path))\n","    tot = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","    if tot <= 0: cap.release(); return []\n","    idxs = np.linspace(0, tot-1, n).astype(int)\n","    frs = []\n","    for i in idxs:\n","        cap.set(cv2.CAP_PROP_POS_FRAMES, int(i))\n","        ok, f = cap.read()\n","        if ok:\n","            f = cv2.cvtColor(f, cv2.COLOR_BGR2RGB)\n","            f = cv2.resize(f, (IMG_SIZE, IMG_SIZE))\n","            frs.append(f)\n","    cap.release()\n","    return frs\n","\n","def cache_frames(df_split, split_name):\n","    out = FRAME_DIR/split_name; out.mkdir(exist_ok=True, parents=True)\n","    rows = []; total = len(df_split)\n","    for idx,(_,r) in enumerate(df_split.iterrows()):\n","        vdir = out/r['vid']; vdir.mkdir(exist_ok=True, parents=True)\n","        exist = sorted(vdir.glob('*.jpg'))\n","        if len(exist) >= FRAMES_PER_VIDEO:\n","            fps = [str(p) for p in exist[:FRAMES_PER_VIDEO]]\n","        else:\n","            frs = extract_frames(r['path']); fps = []\n","            for i, fr in enumerate(frs):\n","                p = vdir/f'{i:02d}.jpg'\n","                Image.fromarray(fr).save(p, quality=90); fps.append(str(p))\n","        for fp in fps:\n","            rows.append({'frame':fp,'label':r['label'],'vid':r['vid']})\n","        if (idx+1)%50==0: print(f'  [{split_name}] {idx+1}/{total}')\n","    return pd.DataFrame(rows)\n","\n","print('📦 프레임 추출 중...\\n')\n","t0 = time.time()\n","train_frames = cache_frames(train_df, 'train'); print(f'✅ Train: {len(train_frames)}')\n","val_frames   = cache_frames(val_df,   'val');   print(f'✅ Val  : {len(val_frames)}')\n","test_frames  = cache_frames(test_df,  'test');  print(f'✅ Test : {len(test_frames)}')\n","print(f'\\n소요: {(time.time()-t0)/60:.1f}분')"],"metadata":{"id":"Q3ZkexK650Z0"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# CLIP 정규화\n","\n","from torchvision import transforms\n","\n","CLIP_MEAN = [0.48145466, 0.4578275,  0.40821073]\n","CLIP_STD  = [0.26862954, 0.26130258, 0.27577711]\n","\n","train_tf = transforms.Compose([\n","    transforms.ToPILImage(),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.ColorJitter(0.2, 0.2, 0.2),\n","    transforms.ToTensor(),\n","    transforms.Normalize(CLIP_MEAN, CLIP_STD),\n","])\n","eval_tf = transforms.Compose([\n","    transforms.ToPILImage(),\n","    transforms.ToTensor(),\n","    transforms.Normalize(CLIP_MEAN, CLIP_STD),\n","])\n","\n","class FrameDataset(Dataset):\n","    def __init__(self, df, tf): self.df, self.tf = df.reset_index(drop=True), tf\n","    def __len__(self): return len(self.df)\n","    def __getitem__(self, i):\n","        r = self.df.iloc[i]\n","        img = np.array(Image.open(r['frame']).convert('RGB'))\n","        return self.tf(img), int(r['label']), r['vid']"],"metadata":{"id":"-jPAavvv50XV"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["counts = Counter(train_frames['label'])\n","weights = train_frames['label'].map(lambda y: 1.0/counts[y]).values\n","sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)\n","\n","train_loader = DataLoader(FrameDataset(train_frames, train_tf), batch_size=BATCH,\n","                          sampler=sampler, num_workers=NUM_WORKERS, pin_memory=True)\n","val_loader   = DataLoader(FrameDataset(val_frames, eval_tf), batch_size=BATCH,\n","                          shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\n","test_loader  = DataLoader(FrameDataset(test_frames, eval_tf), batch_size=BATCH,\n","                          shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\n","print('Loaders ready.')"],"metadata":{"id":"EAtjM2bN50VU"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 5 — CLIP-ViT-B/16 + 수동 LoRA"],"metadata":{"id":"I-g4T9gv6xxV"}},{"cell_type":"code","source":["# 수동 LoRA 구현 (PEFT 없이)\n","\n","class LoRALinear(nn.Module):\n","    \"\"\"원본 Linear + 학습 가능한 저랭크 행렬 두 개\"\"\"\n","    def __init__(self, original: nn.Linear, r=8, alpha=16, dropout=0.05):\n","        super().__init__()\n","        self.original = original\n","        for p in self.original.parameters(): p.requires_grad = False  # 원본 freeze\n","        in_f, out_f = original.in_features, original.out_features\n","        self.lora_A = nn.Linear(in_f, r, bias=False)\n","        self.lora_B = nn.Linear(r, out_f, bias=False)\n","        self.scaling = alpha / r\n","        self.dropout = nn.Dropout(dropout)\n","        nn.init.kaiming_uniform_(self.lora_A.weight, a=5**0.5)\n","        nn.init.zeros_(self.lora_B.weight)\n","    def forward(self, x):\n","        return self.original(x) + self.lora_B(self.lora_A(self.dropout(x))) * self.scaling\n","\n","def apply_lora(vision_model, r=8, alpha=16, dropout=0.05):\n","    \"\"\"CLIP 비전 attention의 q/k/v/out_proj에 LoRA 주입\"\"\"\n","    for layer in vision_model.encoder.layers:\n","        attn = layer.self_attn\n","        attn.q_proj = LoRALinear(attn.q_proj, r, alpha, dropout)\n","        attn.k_proj = LoRALinear(attn.k_proj, r, alpha, dropout)\n","        attn.v_proj = LoRALinear(attn.v_proj, r, alpha, dropout)\n","        attn.out_proj = LoRALinear(attn.out_proj, r, alpha, dropout)"],"metadata":{"id":"OD-sVuAQ50S4"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["class CLIPDetector(nn.Module):\n","    def __init__(self, base='openai/clip-vit-base-patch16', num_classes=2, dropout=0.1):\n","        super().__init__()\n","        clip = CLIPModel.from_pretrained(base)\n","        self.vision = clip.vision_model\n","        feat = clip.config.vision_config.hidden_size\n","        self.head = nn.Sequential(\n","            nn.LayerNorm(feat), nn.Dropout(dropout),\n","            nn.Linear(feat, num_classes)\n","        )\n","    def forward(self, x):\n","        out = self.vision(pixel_values=x)\n","        return self.head(out.pooler_output)\n","\n","# 모델 생성 + LoRA 적용\n","model = CLIPDetector(dropout=0.1).to(device)\n","for p in model.vision.parameters(): p.requires_grad = False   # 백본 전체 freeze\n","apply_lora(model.vision, r=8, alpha=16, dropout=0.05)         # LoRA만 추가\n","model = model.to(device)\n","\n","# 통계\n","n_total = sum(p.numel() for p in model.parameters())\n","n_train = sum(p.numel() for p in model.parameters() if p.requires_grad)\n","print(f'전체 {n_total:,} | 학습 가능 {n_train:,} ({100*n_train/n_total:.2f}%)')"],"metadata":{"id":"XLzhJ2WQ50Qo"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 6 — 학습 (10 epoch)"],"metadata":{"id":"GRj47TMS67IF"}},{"cell_type":"code","source":["from sklearn.utils.class_weight import compute_class_weight\n","cls_w = compute_class_weight('balanced', classes=np.array([0,1]), y=train_frames['label'].values)\n","cls_w = torch.tensor(cls_w, dtype=torch.float).to(device)\n","print('클래스 가중치 (real, fake):', cls_w.cpu().numpy().round(3))\n","\n","criterion = nn.CrossEntropyLoss(weight=cls_w)\n","scaler    = GradScaler('cuda')\n","\n","optimizer = torch.optim.AdamW([\n","    {'params':[p for p in model.vision.parameters() if p.requires_grad], 'lr': LR_LORA},\n","    {'params': model.head.parameters(), 'lr': LR_HEAD},\n","], weight_decay=WD)\n","scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)"],"metadata":{"id":"Ma0nlUKD50Og"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 학습/평가함수\n","\n","def run_epoch(model, loader, train=True, opt=None):\n","    model.train(train)\n","    losses, preds, ys = [], [], []\n","    for x, y, _ in loader:\n","        x, y = x.to(device), y.to(device)\n","        with torch.set_grad_enabled(train):\n","            with autocast('cuda'):\n","                logits = model(x); loss = criterion(logits, y)\n","            if train:\n","                opt.zero_grad()\n","                scaler.scale(loss).backward()\n","                scaler.step(opt); scaler.update()\n","        losses.append(loss.item())\n","        preds.extend(torch.softmax(logits,1)[:,1].detach().cpu().numpy())\n","        ys.extend(y.cpu().numpy())\n","    f1 = f1_score(ys, np.array(preds)>0.5, zero_division=0)\n","    return np.mean(losses), f1"],"metadata":{"id":"-B7zEsDP50MF"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["hist = {'train_loss':[], 'val_loss':[], 'val_f1':[]}\n","best_f1 = 0\n","patience = 3              # 3 epoch 연속 개선 없으면 정지\n","no_improve = 0\n","MAX_EPOCHS = 15           # ← 안전 장치로 최대 15까지 허용\n","\n","print(f'학습 시작 (최대 {MAX_EPOCHS} epoch, patience={patience})\\n')\n","\n","for ep in range(MAX_EPOCHS):\n","    tl, tf = run_epoch(model, train_loader, train=True,  opt=optimizer)\n","    vl, vf = run_epoch(model, val_loader,   train=False, opt=None)\n","    scheduler.step()\n","    hist['train_loss'].append(tl); hist['val_loss'].append(vl); hist['val_f1'].append(vf)\n","\n","    msg = f'[EP {ep+1:2d}/{MAX_EPOCHS}] train={tl:.4f} val={vl:.4f} F1={vf:.3f}'\n","\n","    if vf > best_f1:\n","        best_f1 = vf\n","        no_improve = 0\n","        torch.save(model.state_dict(), CKPT_DIR/'best_initial.pt')\n","        msg += '  ✨ best!'\n","    else:\n","        no_improve += 1\n","        msg += f'  (no_improve={no_improve}/{patience})'\n","\n","    print(msg)\n","\n","    # ⏹️ Early stopping\n","    if no_improve >= patience:\n","        print(f'\\n⏹️ Early stopping at epoch {ep+1} — {patience} 에폭 연속 개선 없음')\n","        break\n","\n","    # 🚨 과적합 감지 (train loss는 떨어지는데 val loss는 오를 때)\n","    if ep >= 3 and hist['val_loss'][-1] > hist['val_loss'][-3] * 1.1:\n","        print(f'⚠️ 과적합 의심: val_loss가 3 epoch 전보다 10% 이상 증가')\n","\n","print(f'\\n✅ Best val F1: {best_f1:.3f} ({len(hist[\"val_f1\"])} epoch 학습)')"],"metadata":{"id":"lsPNdjFo50KU"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 7 — 예측"],"metadata":{"id":"hMwW7Das7Fw3"}},{"cell_type":"code","source":["def predict(model, loader):\n","    model.eval()\n","    yt, yp, vids, times = [], [], [], []\n","    with torch.no_grad(), autocast('cuda'):\n","        for x, y, v in loader:\n","            x = x.to(device)\n","            t0 = time.time()\n","            logits = model(x)\n","            torch.cuda.synchronize()\n","            t = (time.time()-t0) / x.size(0)\n","            times.extend([t]*x.size(0))\n","            prob = torch.softmax(logits,1)[:,1].cpu().numpy()\n","            yt.extend(y.numpy()); yp.extend(prob); vids.extend(v)\n","    return np.array(yt), np.array(yp), np.array(vids), np.array(times)\n","\n","model.load_state_dict(torch.load(CKPT_DIR/'best_initial.pt'))\n","yt, yp, vids_arr, times = predict(model, test_loader)\n","print(f'프레임 {len(yt)}개 | 평균 추론 {times.mean()*1000:.2f} ms/장')"],"metadata":{"id":"oOjpRa3n50H-"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 8 — 평가 (요청 지표 형식)"],"metadata":{"id":"sTaBxx5e7I9k"}},{"cell_type":"code","source":["def evaluate_full(y_true, y_prob, infer_time, threshold=0.5, title='초기 모델'):\n","    yhat = (y_prob > threshold).astype(int)\n","    cm = confusion_matrix(y_true, yhat, labels=[0,1])\n","    tn, fp, fn, tp = cm.ravel()\n","    acc  = accuracy_score(y_true, yhat)\n","    prec = precision_score(y_true, yhat, zero_division=0)\n","    rec  = recall_score(y_true, yhat, zero_division=0)\n","    f1   = f1_score(y_true, yhat, zero_division=0)\n","    fpr  = fp/(fp+tn) if (fp+tn)>0 else 0.0\n","\n","    print(f'========== 성능 평가 결과 ({title}) ==========')\n","    print(f'Accuracy       : {acc*100:.2f}%')\n","    print(f'Precision      : {prec*100:.2f}%')\n","    print(f'Recall         : {rec*100:.2f}%  ← 핵심')\n","    print(f'F1 Score       : {f1*100:.2f}%')\n","    print(f'FPR            : {fpr*100:.2f}%')\n","    print(f'Inference Time : {infer_time:.4f}초')\n","    print(f'------------------------------------')\n","    print(f'TP: {tp}  FP: {fp}  FN: {fn}  TN: {tn}')\n","    print(f'====================================')\n","    return {'accuracy':acc,'precision':prec,'recall':rec,'f1':f1,'fpr':fpr,\n","            'inference_time':infer_time,'tp':int(tp),'fp':int(fp),'fn':int(fn),'tn':int(tn),'cm':cm}\n","\n","# Frame-level\n","print('\\n--- Frame-level ---')\n","result_frame = evaluate_full(yt, yp, times.mean(), title='초기/Frame')\n","\n","# Video-level (영상의 프레임 평균 확률)\n","vp_dict, vl_dict = defaultdict(list), {}\n","for v,y,p in zip(vids_arr, yt, yp):\n","    vp_dict[v].append(p); vl_dict[v]=y\n","v_ids = list(vp_dict.keys())\n","yt_v = np.array([vl_dict[v] for v in v_ids])\n","yp_v = np.array([np.mean(vp_dict[v]) for v in v_ids])\n","\n","print('\\n--- Video-level ---')\n","result_video = evaluate_full(yt_v, yp_v, times.mean()*FRAMES_PER_VIDEO, title='초기/Video')"],"metadata":{"id":"m6PN9bq-50GN"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# CONFUSION MATRIX\n","\n","fig, ax = plt.subplots(1,2,figsize=(9,4))\n","ConfusionMatrixDisplay(result_frame['cm'], display_labels=['real','fake']).plot(ax=ax[0], cmap='Blues', colorbar=False)\n","ax[0].set_title(f\"Frame\\nF1={result_frame['f1']*100:.1f}%\")\n","ConfusionMatrixDisplay(result_video['cm'], display_labels=['real','fake']).plot(ax=ax[1], cmap='Greens', colorbar=False)\n","ax[1].set_title(f\"Video\\nF1={result_video['f1']*100:.1f}%\")\n","plt.tight_layout(); plt.savefig(OUT/'cm_initial.png', dpi=120); plt.show()"],"metadata":{"id":"bLWNMhO_50Du"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 9 — 하이퍼파라미터 튜닝"],"metadata":{"id":"VZohC1o97R7T"}},{"cell_type":"code","source":["import optuna\n","\n","def objective(trial):\n","    lr_lora  = trial.suggest_float('lr_lora', 1e-5, 5e-4, log=True)\n","    lr_head  = trial.suggest_float('lr_head', 1e-4, 1e-3, log=True)\n","    lora_r   = trial.suggest_categorical('lora_r', [4, 8, 16])\n","    dropout  = trial.suggest_float('dropout', 0.0, 0.3)\n","    wd       = trial.suggest_float('wd', 1e-5, 1e-3, log=True)\n","\n","    m = CLIPDetector(dropout=dropout).to(device)\n","    for p in m.vision.parameters(): p.requires_grad = False\n","    apply_lora(m.vision, r=lora_r, alpha=lora_r*2, dropout=dropout)\n","    m = m.to(device)\n","\n","    opt = torch.optim.AdamW([\n","        {'params':[p for p in m.vision.parameters() if p.requires_grad], 'lr': lr_lora},\n","        {'params': m.head.parameters(), 'lr': lr_head},\n","    ], weight_decay=wd)\n","    best = 0\n","    for ep in range(5):\n","        run_epoch(m, train_loader, train=True, opt=opt)\n","        _, vf = run_epoch(m, val_loader, train=False)\n","        if vf > best: best = vf\n","        trial.report(vf, ep)\n","        if trial.should_prune(): raise optuna.TrialPruned()\n","    del m, opt; torch.cuda.empty_cache()\n","    return best\n","\n","study = optuna.create_study(direction='maximize', pruner=optuna.pruners.MedianPruner())\n","study.optimize(objective, n_trials=10, show_progress_bar=True)\n","print('\\n🏆 Best params:', study.best_params)\n","print(f'🏆 Best val F1: {study.best_value:.3f}')"],"metadata":{"id":"wnqTACSE50BX"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 10 — 재학습"],"metadata":{"id":"JOtc-hRe7Vy_"}},{"cell_type":"code","source":["# 최적 파라미터로 10EPOCH 재학습\n","\n","bp = study.best_params\n","\n","model2 = CLIPDetector(dropout=bp['dropout']).to(device)\n","for p in model2.vision.parameters(): p.requires_grad = False\n","apply_lora(model2.vision, r=bp['lora_r'], alpha=bp['lora_r']*2, dropout=bp['dropout'])\n","model2 = model2.to(device)\n","\n","opt2 = torch.optim.AdamW([\n","    {'params':[p for p in model2.vision.parameters() if p.requires_grad], 'lr': bp['lr_lora']},\n","    {'params': model2.head.parameters(), 'lr': bp['lr_head']},\n","], weight_decay=bp['wd'])\n","sched2 = torch.optim.lr_scheduler.CosineAnnealingLR(opt2, T_max=EPOCHS)\n","\n","hist2 = {'train_loss':[], 'val_loss':[], 'val_f1':[]}\n","best_f1_2 = 0\n","for ep in range(EPOCHS):\n","    tl, tf = run_epoch(model2, train_loader, train=True,  opt=opt2)\n","    vl, vf = run_epoch(model2, val_loader,   train=False, opt=None)\n","    sched2.step()\n","    hist2['train_loss'].append(tl); hist2['val_loss'].append(vl); hist2['val_f1'].append(vf)\n","    print(f'[Tuned EP {ep+1:2d}/10] train={tl:.4f} val={vl:.4f} F1={vf:.3f}')\n","    if vf > best_f1_2:\n","        best_f1_2 = vf\n","        torch.save(model2.state_dict(), CKPT_DIR/'best_tuned.pt')\n","print(f'\\n✅ Tuned best val F1: {best_f1_2:.3f}')"],"metadata":{"id":"cJ30QXao5z_P"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 11 — 재평가"],"metadata":{"id":"UL_zwH8-7fsj"}},{"cell_type":"code","source":["model2.load_state_dict(torch.load(CKPT_DIR/'best_tuned.pt'))\n","yt2, yp2, vids2, times2 = predict(model2, test_loader)\n","\n","print('\\n--- Tuned Frame-level ---')\n","result_frame_t = evaluate_full(yt2, yp2, times2.mean(), title='튜닝/Frame')\n","\n","vp2, vl2 = defaultdict(list), {}\n","for v,y,p in zip(vids2, yt2, yp2):\n","    vp2[v].append(p); vl2[v]=y\n","vids_u2 = list(vp2.keys())\n","yt_v2 = np.array([vl2[v] for v in vids_u2])\n","yp_v2 = np.array([np.mean(vp2[v]) for v in vids_u2])\n","\n","print('\\n--- Tuned Video-level ---')\n","result_video_t = evaluate_full(yt_v2, yp_v2, times2.mean()*FRAMES_PER_VIDEO, title='튜닝/Video')"],"metadata":{"id":"vczW3gx-5z9O"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Before vs After 비교표\n","\n","comp = pd.DataFrame({\n","    'Metric':         ['Accuracy','Precision','Recall(핵심)','F1','FPR','Inference(ms)'],\n","    'Initial-Frame':  [f\"{result_frame['accuracy']*100:.2f}%\",\n","                       f\"{result_frame['precision']*100:.2f}%\",\n","                       f\"{result_frame['recall']*100:.2f}%\",\n","                       f\"{result_frame['f1']*100:.2f}%\",\n","                       f\"{result_frame['fpr']*100:.2f}%\",\n","                       f\"{result_frame['inference_time']*1000:.2f}\"],\n","    'Tuned-Frame':    [f\"{result_frame_t['accuracy']*100:.2f}%\",\n","                       f\"{result_frame_t['precision']*100:.2f}%\",\n","                       f\"{result_frame_t['recall']*100:.2f}%\",\n","                       f\"{result_frame_t['f1']*100:.2f}%\",\n","                       f\"{result_frame_t['fpr']*100:.2f}%\",\n","                       f\"{result_frame_t['inference_time']*1000:.2f}\"],\n","    'Initial-Video':  [f\"{result_video['accuracy']*100:.2f}%\",\n","                       f\"{result_video['precision']*100:.2f}%\",\n","                       f\"{result_video['recall']*100:.2f}%\",\n","                       f\"{result_video['f1']*100:.2f}%\",\n","                       f\"{result_video['fpr']*100:.2f}%\",\n","                       f\"{result_video['inference_time']*1000:.2f}\"],\n","    'Tuned-Video':    [f\"{result_video_t['accuracy']*100:.2f}%\",\n","                       f\"{result_video_t['precision']*100:.2f}%\",\n","                       f\"{result_video_t['recall']*100:.2f}%\",\n","                       f\"{result_video_t['f1']*100:.2f}%\",\n","                       f\"{result_video_t['fpr']*100:.2f}%\",\n","                       f\"{result_video_t['inference_time']*1000:.2f}\"],\n","})\n","print(comp.to_string(index=False))\n","comp.to_csv(OUT/'comparison.csv', index=False)"],"metadata":{"id":"TF8g7AtN5z7J"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Phase 12 — Gemini 2-stage XAI (LTE 영감)"],"metadata":{"id":"jRZmmJ6m7nli"}},{"cell_type":"code","source":["# GEMINI 세팅\n","\n","import google.generativeai as genai\n","import google.api_core.exceptions as g_exc\n","from google.colab import userdata\n","import getpass\n","\n","def get_key():\n","    k = None\n","    try:\n","        raw = userdata.get('GOOGLE_API_KEY')\n","        if isinstance(raw,str) and raw.startswith('AIza'): k = raw\n","        elif isinstance(raw,dict): k = raw.get('data',{}).get('payload') or raw.get('payload')\n","    except: pass\n","    if not k: k = getpass.getpass('GOOGLE_API_KEY: ').strip()\n","    return k\n","\n","genai.configure(api_key=get_key())\n","GEMINI_MODEL = 'gemini-2.5-flash-lite'\n","\n","try:\n","    m = genai.GenerativeModel(GEMINI_MODEL)\n","    r = m.generate_content('ping', generation_config={'max_output_tokens':5})\n","    print(f'✅ {GEMINI_MODEL} 호출 성공')\n","except Exception as e:\n","    print(f'⚠️ {e}')"],"metadata":{"id":"0xrDI4lU5z5Q"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["LOCATE_PROMPT = \"\"\"이 영상 프레임이 AI 생성인지 실제인지 분석하세요.\n","1) 의심 영역(손/얼굴/배경/텍스트/물체 모서리 등) 식별\n","2) 그 영역의 이상점을 짧게 설명\n","JSON만:\n","{\"suspicious_regions\": [\"...\"], \"initial_verdict\": \"AI\" or \"real\"}\"\"\"\n","\n","EXAMINE_PROMPT = \"\"\"앞서 의심 영역: {regions}\n","CNN AI 확률: {prob:.2%}\n","\n","루브릭:\n","- temporal_artifacts: 프레임 간 깜빡임\n","- physics_violation: 물리법칙 위반\n","- anatomy_defects: 손가락/얼굴 비율 이상\n","- texture_smoothness: 비현실적으로 매끄러움\n","- background_warping: 배경 왜곡\n","- lighting_incoherence: 광원/그림자 불일치\n","\n","JSON 스키마:\n","{{\n","  \"verdict\": \"AI-generated\" | \"real\",\n","  \"confidence\": 0.0~1.0,\n","  \"evidence\": [{{\"region\":\"...\",\"artifact\":\"...\",\"severity\":\"high|mid|low\"}}],\n","  \"summary_ko\": \"한국어 2~3문장\"\n","}}\n","JSON만 출력.\"\"\"\n","\n","def call_gemini(contents, max_retry=3):\n","    gm = genai.GenerativeModel(GEMINI_MODEL)\n","    for a in range(max_retry):\n","        try: return gm.generate_content(contents)\n","        except g_exc.TooManyRequests:\n","            time.sleep(15*(2**a))\n","    raise RuntimeError('Gemini 재시도 실패')"],"metadata":{"id":"4eu3edYH5z3L"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def detect_video_2stage(video_path, model, topk=3):\n","    frames = extract_frames(video_path, n=FRAMES_PER_VIDEO)\n","    if not frames: return {'error':'no frames'}\n","\n","    # CNN 1차\n","    xs = torch.stack([eval_tf(f) for f in frames]).to(device)\n","    with torch.no_grad(), autocast('cuda'):\n","        probs = torch.softmax(model(xs),1)[:,1].cpu().numpy()\n","    prob_ai = float(probs.mean())\n","\n","    if prob_ai < 0.75:\n","        return {'verdict':'REAL/UNCERTAIN','prob_ai':prob_ai,\n","                'reason':'임계값 75% 미만 → Gemini 생략'}\n","\n","    # Top-k 프레임 선택\n","    top_idx = np.argsort(-probs)[:topk]\n","    pil_frames = [Image.fromarray(frames[i]) for i in top_idx]\n","\n","    # Stage 1: Locate\n","    r1 = call_gemini([LOCATE_PROMPT, *pil_frames])\n","    try:\n","        s1 = json.loads(r1.text.strip().lstrip('```json').rstrip('```').strip())\n","        regions = s1.get('suspicious_regions', ['전체'])\n","    except:\n","        regions = ['전체']; s1 = {'raw': r1.text}\n","\n","    time.sleep(5)   # RPM 여유\n","\n","    # Stage 2: Examine\n","    r2 = call_gemini([EXAMINE_PROMPT.format(regions=regions, prob=prob_ai), *pil_frames])\n","    try:\n","        s2 = json.loads(r2.text.strip().lstrip('```json').rstrip('```').strip())\n","    except Exception as e:\n","        s2 = {'raw': r2.text, 'parse_error': str(e)}\n","\n","    return {'video': str(video_path), 'cnn_prob_ai': prob_ai,\n","            'stage1_locate': s1, 'stage2_examine': s2}"],"metadata":{"id":"LMlTAdOy5z1C"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 샘플영상에 추론\n","\n","sample_videos = test_df.sample(3, random_state=1).to_dict('records')\n","model2.load_state_dict(torch.load(CKPT_DIR/'best_tuned.pt'))\n","model2.eval()\n","\n","xai_results = []\n","for i, r in enumerate(sample_videos):\n","    print(f\"\\n🎬 [{i+1}/3] {r['vid']} (GT={'FAKE' if r['label']==1 else 'REAL'})\")\n","    out = detect_video_2stage(r['path'], model2)\n","    print(json.dumps(out, ensure_ascii=False, indent=2)[:1500])\n","    xai_results.append({'gt':int(r['label']), **out})\n","    if i < 2: time.sleep(8)"],"metadata":{"id":"c6tRQV-u5zzG"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 최종본 다운로드\n","final = {\n","    'dataset': 'GenVidBench',\n","    'detection_model': 'CLIP-ViT-B/16 + Manual LoRA',\n","    'reasoning_model': GEMINI_MODEL,\n","    'data': {'train': len(train_df), 'val': len(val_df), 'test': len(test_df)},\n","    'initial_frame':  {k:v for k,v in result_frame.items() if k!='cm'},\n","    'initial_video':  {k:v for k,v in result_video.items() if k!='cm'},\n","    'best_hyperparams': study.best_params,\n","    'tuned_frame':   {k:v for k,v in result_frame_t.items() if k!='cm'},\n","    'tuned_video':   {k:v for k,v in result_video_t.items() if k!='cm'},\n","    'xai_samples':   xai_results,\n","}\n","with open(OUT/'final_report.json','w',encoding='utf-8') as f:\n","    json.dump(final, f, ensure_ascii=False, indent=2, default=str)\n","print('✅ 저장 완료')\n","\n","zp = '/content/genvid_results.zip'\n","with zipfile.ZipFile(zp,'w',zipfile.ZIP_DEFLATED) as z:\n","    for p in OUT.rglob('*'): z.write(p, p.relative_to(OUT))\n","    for p in CKPT_DIR.rglob('*'): z.write(p, f'ckpt/{p.name}')\n","from google.colab import files\n","files.download(zp)"],"metadata":{"id":"hgevGFf15zwy"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"RfZfmlk85zu3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"gkgq_V5l5zs2"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"Y3wSXHQ05zqy"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"C_Nhs7W05zom"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"p1tMMoZZ5zmg"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"w2Gy-B5f5zkT"},"execution_count":null,"outputs":[]}]}